# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# testing
/coverage
/.nyc_output
coverage-final.json

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# env files (can opt-in for committing if needed)
.env*
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors/IDE
.vscode/
.idea/

# caches
.cache/

# logs
logs/
*.log

# agents
/.agent/
.agent/
/.agents/
.agents/



# Python and virtualenvs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.python-version
venv/
env/
.venv/
pip-wheel-metadata/
*.egg-info/
*.egg

# Python build/dist
build/
dist/
eggs/
parts/
sdist/
wheels/

# Jupyter
.ipynb_checkpoints/

# Lockfiles
package-lock.json
pnpm-lock.yaml
yarn.lock

# Editor swap/backup files
*.swp
*~

# Local caches and system files
.cache/
.local/
Thumbs.db

# Database
*.sqlite3
*.db

